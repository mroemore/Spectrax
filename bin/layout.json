{
    "styles": {
        "dial": {
            "knob": {
                "size": 20,
                "radius": 10,
                "startAngle": -225,
                "sweep": 270,
                "offsetX": 0,
                "offsetY": 0,
                "asset": "resources/images/dial2.png",
                "color": "dial"
            },
            "border": {
                "roundness": 0.125,
                "borderWidth": 2.0,
                "color": "panelBorder"
            },
            "value": {
                "format": "%05.2f",
                "width": 38,
                "height": 14,
                "offsetX": 28,
                "offsetY": 2,
                "color": "valueText"
            },
            "label": {
                "font": "pixel",
                "fontSize": 9,
                "spacing": 1,
                "offsetX": 0,
                "offsetY": 18,
                "color": "label",
                "colorSelected": "labelSelected"
            }
        },
        "dial-discrete": {
            "extends": "dial",
            "value": {
                "format": "%i",
                "width": 10,
                "offsetX": 6,
                "offsetY": 5
            },
            "label": {
                "offsetX": 6,
                "offsetY": 21
            }
        },
        "btn": {
            "border": {
                "roundness": 0.125,
                "borderWidth": 2.0,
                "color": "panelBorder"
            },
            "label": {
                "font": "pixel",
                "fontSize": 10,
                "spacing": 1,
                "offsetX": 4,
                "offsetY": 4,
                "color": "label",
                "colorSelected": "labelSelected"
            }
        },
        "type-label": {
            "label": {
                "font": "pixel",
                "fontSize": 10,
                "spacing": 1,
                "color": "label",
                "colorSelected": "labelSelected"
            },
            "border": {
                "roundness": 0.125,
                "borderWidth": 2.0,
                "color": "outlineColour"
            }
        },
        "text": {
            "font": "pixel",
            "fontSize": 10,
            "spacing": 1,
            "offsetX": 0,
            "offsetY": 0,
            "hAlign": "left",
            "vAlign": "top",
            "color": "font",
            "colorSelected": "font"
        },
        "stage-curve-icon": {
            "extends": "curve-icon",
            "frameCount": 32,
            "size": 16,
            "offsetX": 2,
            "offsetY": 2,
            "color": "valueText"
        },
        "stage-rate": {
            "extends": "dial",
            "value": {
                "format": "%04.1f",
                "fontSize": 7,
                "offsetX": 28,
                "offsetY": 34,
                "width": 38,
                "height": 14
            }
        },
        "stage-curve": {
            "extends": "dial",
            "knob": {
                "size": 13,
                "radius": 7
            },
            "value": {
                "width": 0,
                "height": 0,
                "fontSize": 0
            }
        }
    },
    "layouts": {
        "mod-source-row": {
            "orientation": "horizontal",
            "padding": 2,
            "gap": 2,
            "weights": [
                3,
                4,
                4,
                4,
                4,
                3,
                2,
                1
            ]
        },
        "env-row": {
            "orientation": "horizontal",
            "padding": 4,
            "weights": [
                1,
                2,
                1
            ],
            "childClasses": [
                "",
                "big-dial",
                ""
            ]
        },
        "fm-op-row": {
            "orientation": "horizontal",
            "padding": 1,
            "weights": [
                1,
                1,
                1,
                1,
                1
            ]
        },
        "env-stage": {
            "orientation": "horizontal",
            "padding": 2,
            "weights": [
                2,
                1
            ],
            "childClasses": [
                "stage-rate",
                "stage-curve"
            ]
        }
    }
