#!/usr/bin/env bash
# meson/pre-push — fast local gate. Install as .git/hooks/pre-push:
#
#   ln -sf ../../meson/pre-push .git/hooks/pre-push
#
# Runs only the cheap tier (build + suite + coverage gate). It must fail
# loudly rather than exit 0 unconditionally — an earlier project hook ended in
# `|| true`, so it could never block a push (see TESTING.md I22).
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push: not in a git tree" >&2; exit 0; }

if [ ! -x "$ROOT/meson/check.sh" ]; then
  # The hook exists to run the gates. If there are no gates, it has nothing
  # to do - and exiting 0 would be a green light over work that never
  # happened, the exact shape the gate exists to prevent. A hook that was
  # never installed should be installed or removed; a hook that is installed
  # and cannot find its gates is a broken installation, and it says so.
  echo "pre-push: meson/check.sh is missing at $ROOT/meson/check.sh" >&2
  echo "pre-push: this hook cannot run any gate, so it is not blocking anything." >&2
  echo "pre-push: install the CTOL stack, or remove the hook:" >&2
  echo "  ln -sf ../../meson/pre-push .git/hooks/pre-push" >&2
  echo "  rm .git/hooks/pre-push" >&2
  exit 1
fi

echo "pre-push: running fast tier (./meson/check.sh --quiet)"
if ! "$ROOT/meson/check.sh" --quiet; then
  echo
  echo "pre-push: fast tier FAILED — push blocked." >&2
  echo "  Fix it, or bypass once with: git push --no-verify" >&2
  echo "  Full tier (matrix/fuzz/mutation): ./meson/check.sh --full" >&2
  exit 1
fi
echo "pre-push: fast tier passed."
